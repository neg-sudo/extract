#!/usr/bin/env bash
# extract - Universal archive extractor for all platforms
# Copyright (c) 2026 extract contributors
# Licensed under MIT License

set -e

# Resolve symlinks portably (Linux, macOS, BSD).
SELF="$0"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"

# Locate the Python implementation.
LIB="${EXTRACT_LIB:-$DIR/../lib/extract.py}"
[ -f "$LIB" ] || LIB="$HOME/.extract/lib/extract.py"
[ -f "$LIB" ] || LIB="$DIR/lib/extract.py"
if [ ! -f "$LIB" ]; then
    echo "extract: could not locate extract.py (looked next to $DIR and in ~/.extract/lib)" >&2
    exit 1
fi

# Pick a Python 3 interpreter.
for PY in "${EXTRACT_PYTHON:-}" python3 python py; do
    [ -n "$PY" ] || continue
    if command -v "$PY" >/dev/null 2>&1; then
        exec "$PY" "$LIB" "$@"
    fi
done

echo "extract: Python 3 is required but was not found" >&2
exit 1
